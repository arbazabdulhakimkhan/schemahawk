# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Every value below is optional: safe defaults are built into the code.

# --- AI (used from V2 onwards; V1 discovery never calls an LLM) ---
OPENAI_API_KEY=

# --- Notifications (Telegram; used from V5 onwards) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Master profile ---
RESUME_MASTER_PATH=data/master_resume.docx
PROFILE_TITLES=Data Engineer,Azure Data Engineer,ETL Developer,Analytics Engineer,Databricks Engineer,Snowflake Engineer,BI Data Engineer

# --- Freshness rules (minutes) ---
FRESH_MAX_MINUTES=60
RECENT_MAX_MINUTES=180

# --- Relevance (0-100; jobs below the threshold are stored but rejected) ---
MIN_RELEVANCE_SCORE=60
# Extra role phrases that count as a strong data-engineering match (comma separated).
RELEVANCE_EXTRA_KEYWORDS=

# --- Sources ---
# Poll only these adapters. Unknown names are ignored; unconfigured ones are
# reported as "skipped" instead of failing.
ENABLED_SOURCES=remoteok,remotive,jobicy,weworkremotely,adzuna,company_boards

# --- HTTP behaviour, per (connect, read) seconds ---
HTTP_TIMEOUT_SECONDS=5,20
HTTP_RETRIES=2
PER_SOURCE_LIMIT=60
MAX_DESCRIPTION_CHARS=5000

# --- Optional: Adzuna official API (https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=gb,us,de,ca,au,nl,fr,in

# --- Optional: company career boards (public Greenhouse / Lever APIs) ---
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# --- Storage / filtering policy ---
SCHEMAHAWK_DB=data/schemahawk.db
REJECT_RESTRICTED=true
