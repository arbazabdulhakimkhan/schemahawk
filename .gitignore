# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Secrets (NEVER commit) ---
.env

# --- Candidate profile (PRIVATE, never commit) ---
# config/profile.example.yaml IS committed (generic template only).
# The real profile stays local and must never reach the public repository.
/config/profile.yaml
/config/*.local.yaml
/config/*.private.yaml
/config/profile.*.yaml
!config/profile.example.yaml

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Notebooks ---
.ipynb_checkpoints/

# --- Local data / outputs (never commit) ---
data/
reports/
.pytest_cache/
*.sqlite3
*.db
out/
logs/
